<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Rynx.Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/rynx_dark_bg</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/rynx_dark_accent</item>
    </style>
    <style name="Theme.Rynx.Light" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/rynx_light_bg</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/rynx_light_accent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
